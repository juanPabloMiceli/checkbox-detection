server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Leave room for multipart overhead above the mock API's 10 MiB limit.
    client_max_body_size 11m;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location ~ ^/detect(?:/|$) {
        # No trailing slash: preserve /detect when forwarding.
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_ssl_trusted_certificate /etc/ssl/cert.pem;
        proxy_ssl_verify on;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_read_timeout 120s;
    }

    location = /index.html {
        add_header Cache-Control "no-store";
    }

    # Angular production bundles contain content hashes.
    location ~* ^/(?:main|styles|chunk|polyfills)-[a-zA-Z0-9_-]+\.(?:js|css)$ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
}
